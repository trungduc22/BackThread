<Project>
  <!--
    Resolves NativeShellKit modules for BackThread desktop projects (Daemon and App only).
    BackThread.Host.Core / Audio / Transport / Media remain 100% independent of NativeShellKit and WinUI.

    Resolution order:
      1. PackageReference from GitHub Packages (default in CI and reproducible builds; version pinned in Directory.Packages.props)
      2. Explicit local source override: pass -p:NativeShellKitRoot=<path/to/NativeShellKit/src> -p:NativeShellKitUseSource=true
  -->
  <PropertyGroup>
    <NativeShellKitUseSource Condition="'$(NativeShellKitUseSource)' == ''">false</NativeShellKitUseSource>
    <NativeShellKitRoot Condition="'$(NativeShellKitRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', 'NativeShellKit', 'src'))</NativeShellKitRoot>
    <NativeShellKitRoot>$([MSBuild]::EnsureTrailingSlash('$(NativeShellKitRoot)'))</NativeShellKitRoot>
    <NativeShellKitFromSource Condition="'$(NativeShellKitUseSource)' == 'true' and Exists('$(NativeShellKitRoot)NativeShellKit.Abstractions/NativeShellKit.Abstractions.csproj')">true</NativeShellKitFromSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeShellKitFromSource)' == 'true'">
    <ProjectReference Include="@(NativeShellKitModule->'$(NativeShellKitRoot)NativeShellKit.%(Identity)/NativeShellKit.%(Identity).csproj')" />
  </ItemGroup>

  <ItemGroup Condition="'$(NativeShellKitFromSource)' != 'true'">
    <PackageReference Include="@(NativeShellKitModule->'NativeShellKit.%(Identity)')" />
  </ItemGroup>
</Project>
